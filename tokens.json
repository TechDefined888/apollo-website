{
  "colors": {
    "primary": {
      "navy": "#0A192F",
      "navy_light": "#112240"
    },
    "neutral": {
      "white": "#FFFFFF",
      "off_white": "#F9F9F8",
      "warm_grey": "#E5E4E2",
      "dark_text": "#1A1A1A"
    },
    "border": {
      "accent": "#D1D1D1",
      "subtle": "#E5E4E2"
    }
  },
  "typography": {
    "fonts": {
      "heading": "'Fraunces', serif",
      "body": "'Inter Tight', sans-serif"
    },
    "scale": {
      "h1": {
        "size": "clamp(3rem, 5vw + 1rem, 4.5rem)",
        "lineHeight": "1.1",
        "letterSpacing": "-0.04em",
        "weight": "300"
      },
      "h2": {
        "size": "clamp(2rem, 3vw + 1rem, 3rem)",
        "lineHeight": "1.2",
        "letterSpacing": "-0.02em",
        "weight": "300"
      },
      "h3": {
        "size": "clamp(1.25rem, 2vw + 0.5rem, 1.75rem)",
        "lineHeight": "1.3",
        "letterSpacing": "-0.01em",
        "weight": "400"
      },
      "body": {
        "size": "1.125rem",
        "lineHeight": "1.6",
        "letterSpacing": "0",
        "weight": "300"
      },
      "overline": {
        "size": "0.75rem",
        "lineHeight": "1.5",
        "letterSpacing": "0.2em",
        "weight": "500",
        "textTransform": "uppercase"
      }
    }
  },
  "spacing": {
    "section_py": "clamp(6rem, 10vw, 10rem)",
    "container_px": "clamp(1.5rem, 5vw, 4rem)",
    "grid_gap": "clamp(2rem, 5vw, 4rem)"
  },
  "borders": {
    "radius": {
      "none": "0px",
      "sm": "2px"
    },
    "width": {
      "thin": "1px",
      "thick": "2px"
    }
  },
  "shadows": {
    "none": "none",
    "subtle_hover": "0 10px 40px -10px rgba(10, 25, 47, 0.08)"
  }
}